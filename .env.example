APP_NAME="Cromos Trading"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=UTC

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file

# El servidor embebido atiende peticiones en paralelo con varios workers;
# sin esto el script de concurrencia no podría demostrar nada.
PHP_CLI_SERVER_WORKERS=8

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=trading
DB_USERNAME=trading
DB_PASSWORD=secret

SESSION_DRIVER=file
SESSION_LIFETIME=120

BROADCAST_CONNECTION=reverb
QUEUE_CONNECTION=database
CACHE_STORE=database
FILESYSTEM_DISK=local

REVERB_APP_ID=cromos
REVERB_APP_KEY=cromos-key
REVERB_APP_SECRET=cromos-secret
# Desde dónde el backend publica en Reverb (red interna de docker)...
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http
# ...y desde dónde se conecta el navegador.
REVERB_PUBLIC_HOST=localhost
REVERB_PUBLIC_PORT=8080
